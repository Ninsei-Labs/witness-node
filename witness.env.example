# Witness-v1 service settings. This is a SEPARATE process from the RFQ node, not part of rfq.env.
# Copy it next to witness-server.mjs, fill in the site origin and run:
#   set -a; . ./witness.env; set +a; bun witness-server.mjs
#
# In a container, set RFQ_WITNESS_HOST=0.0.0.0 (the image default) and keep the published port on loopback.

# The Monero daemon to read. Use the operator's own daemon, not a public one.
RFQ_XMR_DAEMON=http://127.0.0.1:38081

# mainnet | stagenet | testnet. It must match the daemon and the address network.
RFQ_WITNESS_NETWORK=stagenet

# Keep the service on loopback and publish it through a TLS reverse proxy. 8795 is used by the documented
# screen-hook example, so the witness uses 8796.
RFQ_WITNESS_HOST=127.0.0.1
RFQ_WITNESS_PORT=8796

# Narrow this to the site origin when the site is known; `*` is the default for an independent witness.
RFQ_WITNESS_ALLOW_ORIGIN=https://swap.example

# Per-daemon request deadline.
RFQ_WITNESS_TIMEOUT_MS=8000

# Optional public metadata. Leave unset to answer null; do not put private contact data here.
# RFQ_WITNESS_OPERATOR=Ninsei
# RFQ_WITNESS_CONTACT=ops@example.org

# /metrics is loopback-only by default. Publish it only behind a proxy that protects the route.
# RFQ_WITNESS_METRICS_PUBLISH=0

# Readiness probe cache, so metrics and health scrapes do not hammer the daemon.
RFQ_WITNESS_HEALTH_TTL_MS=5000

# Concurrent daemon-backed requests. One slice costs up to 20 block reads plus one tip read; keep this small on a public witness.
RFQ_WITNESS_MAX_INFLIGHT=4

# Request and header deadline. A body that never arrives must not hold a connection.
RFQ_WITNESS_REQUEST_TIMEOUT_MS=10000
