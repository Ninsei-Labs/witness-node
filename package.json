{
  "name": "@ninsei-labs/witness-node",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Read-only fixed-slice Monero witness for the Ninsei arrival protocol",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ninsei-Labs/witness-node.git"
  },
  "homepage": "https://github.com/Ninsei-Labs/witness-node#readme",
  "bugs": {
    "url": "https://github.com/Ninsei-Labs/witness-node/issues"
  },
  "keywords": [
    "monero",
    "witness",
    "privacy",
    "atomic-swap",
    "bun"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun witness-server.mjs",
    "check": "bun run check:version && bun run check:slice && bun run check:teeth && bun run check:workflows",
    "check:version": "bun tools/check-version.mjs",
    "check:slice": "bun tools/check-witness-slice.mjs",
    "check:teeth": "bun tools/check-witness-teeth.mjs",
    "check:workflows": "bun tools/check-workflows.mjs",
    "check:interop": "bun tools/check-sdk-interop.mjs",
    "check:container": "bun tools/check-container.mjs"
  }
}
